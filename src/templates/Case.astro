---
import Layout from '../layouts/Layout.astro';import {copy,projects} from '../data/content.js';const {lang,slug}=Astro.props;const p=projects.find(x=>x.slug===slug);const t=copy[lang];const lunaria=p.slug==='lunaria';const threadlab=p.slug==='threadlab';const synova=p.slug==='synova';
---
<Layout lang={lang} page="work" title={`${p.name} — Daniela Frías`}>
{synova ? <>
  <section class="synova-hero"><nav class="synova-crumb"><a href={`/${lang}/`}>{t.nav.home}</a> / <a href={`/${lang}/work/`}>{t.nav.work}</a> / Synova</nav><span class="synova-eyebrow">03 / {lang==='es'?'IDENTIDAD VISUAL · CÓDIGO ABIERTO':'VISUAL IDENTITY · OPEN SOURCE'}</span><h1>SYNOVA<span>✳</span></h1><p>{lang==='es'?'Una identidad visual para el ámbito sanitario: ciencia, sensibilidad y un sistema gráfico de tonos luminosos.':'A healthcare visual identity blending science, sensitivity, and a luminous graphic system.'}</p><img src="/projects/synova/01.webp" alt={lang==='es'?'Sistema de marca Synova: logotipo, tipografía y paleta':'Synova branding system: logo, typography and palette'} fetchpriority="high"/></section>
  <section class="synova-section"><div class="synova-label">01 / {lang==='es'?'SISTEMA VISUAL':'VISUAL SYSTEM'}</div><h2>{lang==='es'?'UNA MARCA CON LENGUAJE PROPIO.':'A DISTINCT VISUAL LANGUAGE.'}</h2><p>{lang==='es'?'El material muestra la tipografía Aeonik, una paleta de azules, verdes y tonos pastel, y aplicaciones de la identidad de Synova.':'The supplied materials showcase Aeonik typography, a palette of blues, greens and pastels, and applications of the Synova identity.'}</p><div class="synova-gallery"><img src="/projects/synova/02.webp" loading="lazy" alt={lang==='es'?'Aplicación de marca en presentación médica':'Medical presentation branding'}/><img src="/projects/synova/03.webp" loading="lazy" alt={lang==='es'?'Aplicaciones para redes sociales':'Social media brand applications'}/></div></section>
  <section class="synova-section synova-soft"><div class="synova-label">02 / {lang==='es'?'APLICACIONES':'APPLICATIONS'}</div><h2>{lang==='es'?'DEL SISTEMA A LOS OBJETOS.':'FROM SYSTEM TO OBJECTS.'}</h2><div class="synova-gallery"><img src="/projects/synova/04.webp" loading="lazy" alt={lang==='es'?'Uniforme sanitario con identidad Synova':'Synova branded healthcare uniform'}/><img src="/projects/synova/05.webp" loading="lazy" alt={lang==='es'?'Espacio de recepción de Synova':'Synova reception environment'}/><img src="/projects/synova/06.webp" loading="lazy" alt={lang==='es'?'Packaging de Synova':'Synova packaging design'}/></div></section>
  <section class="synova-section synova-motion"><div class="synova-label">03 / {lang==='es'?'PRESENTACIÓN AUDIOVISUAL':'MOTION SHOWCASE'}</div><h2>{lang==='es'?'LA IDENTIDAD EN MOVIMIENTO.':'THE IDENTITY IN MOTION.'}</h2><div class="synova-gallery"><video controls playsinline preload="metadata" aria-label={lang==='es'?'Primer video de Synova':'First Synova project video'}><source src="/projects/synova/video-01.mp4" type="video/mp4"/></video><video controls playsinline preload="metadata" aria-label={lang==='es'?'Segundo video de Synova':'Second Synova project video'}><source src="/projects/synova/video-02.mp4" type="video/mp4"/></video></div></section>
  <section class="synova-section"><div class="synova-label">04 / {lang==='es'?'DOCUMENTACIÓN':'DOCUMENTATION'}</div><h2>{lang==='es'?'CÓDIGO ABIERTO.':'OPEN SOURCE.'}</h2><p>{lang==='es'?'Proyecto identificado como código abierto. Aún falta documentar el repositorio, la licencia, el alcance técnico y qué parte del trabajo se implementó mediante código. No atribuimos un framework sin confirmación.':'Identified as an open-source project. Repository, license, technical scope and which parts were implemented in code remain to be documented. No framework is attributed without confirmation.'}</p><a class="button button-dark" href={`/${lang}/work/`}>← {lang==='es'?'Todos los proyectos':'All projects'}</a></section>
  </> : threadlab ? <>
 <section class="threadlab-hero"><div class="threadlab-crumb"><a href={`/${lang}/`}>{t.nav.home}</a> <span>/</span> <a href={`/${lang}/work/`}>{t.nav.work}</a> <span>/</span> ThreadLab</div><div class="threadlab-heading"><span>02 / FEATURED ASTRO PROJECT</span><span>FASHION TECHNOLOGY — INTERFACE DESIGN</span></div><div class="threadlab-top"><div><span class="threadlab-label">ASTRO / DIGITAL EXPERIENCE</span><h1>THREAD<span>LAB</span><sup>✳</sup></h1></div><p>{lang==='es'?'Una experiencia digital con un lenguaje visual entre el universo de la moda y las herramientas creativas. Un concepto de interacción que explora tejidos, prendas y personalización 3D.':'A digital experience combining the language of fashion with creative software interfaces. An interaction concept exploring fabrics, garments and 3D customization.'}</p></div><img class="threadlab-image threadlab-primary" src="/projects/threadlab/01-platform.webp" alt={lang==='es'?'Portada del proyecto ThreadLab sobre tecnología de moda':'ThreadLab fashion-technology project overview'}/><div class="threadlab-metadata"><span>PROJECT / THREADLAB</span><span>FRAMEWORK / ASTRO</span><span>SHOWCASE / RESPONSIVE + VIDEO</span></div></section>
 <section class="threadlab-block threadlab-dark"><div class="threadlab-small">01 — {lang==='es'?'CONCEPTO':'CONCEPT'}</div><div class="threadlab-split"><h2>{lang==='es'?'DISEÑAR LA EXPERIENCIA.':'DESIGN THE EXPERIENCE.'}</h2><p>{lang==='es'?'La propuesta muestra una plataforma de moda con una dirección visual oscura, composiciones editoriales de gran escala y llamadas a explorar una experiencia 3D.':'The visuals propose a fashion platform with a dark visual direction, oversized editorial compositions and entry points to a 3D experience.'}</p></div><img class="threadlab-image" src="/projects/threadlab/05-technology.webp" loading="lazy" alt={lang==='es'?'Pantalla de tecnología 3D de ThreadLab':'ThreadLab 3D technology presentation'}/></section>
 <section class="threadlab-block threadlab-contrast"><div class="threadlab-small">02 — {lang==='es'?'CONFIGURACIÓN':'CONFIGURATION'}</div><div class="threadlab-split"><h2>{lang==='es'?'MATERIALES, COLOR Y CONTROL.':'MATERIAL, COLOR & CONTROL.'}</h2><p>{lang==='es'?'La interfaz ilustrada presenta un espacio de personalización con selección de tejidos, variaciones cromáticas y herramientas de edición. Estas capturas documentan el diseño; las funciones implementadas quedan pendientes de verificación.':'The depicted customization workspace includes fabric choices, color variations and editing tools. These screenshots document the design; implemented behavior is yet to be verified.'}</p></div><img class="threadlab-image" src="/projects/threadlab/02-configurator.webp" loading="lazy" alt={lang==='es'?'Diseño del configurador de prendas y galería de tejidos':'Garment configurator and fabric gallery design'}/></section>
 <section class="threadlab-block threadlab-dark"><div class="threadlab-small">03 — {lang==='es'?'DISEÑO ADAPTATIVO':'RESPONSIVE DESIGN'}</div><h2>{lang==='es'?'LA MISMA IDENTIDAD. DISTINTAS PANTALLAS.':'ONE VISUAL SYSTEM. DIFFERENT SCREENS.'}</h2><div class="threadlab-gallery"><img class="threadlab-image" src="/projects/threadlab/03-fabrics.webp" loading="lazy" alt={lang==='es'?'Diseño de telas y flujo en móvil y tablet':'Fabric selection and workflow across mobile and tablet'}/><img class="threadlab-image" src="/projects/threadlab/04-responsive.webp" loading="lazy" alt={lang==='es'?'Composición responsive de ThreadLab':'ThreadLab responsive layout composition'}/></div></section>
 <section class="threadlab-block threadlab-video"><div class="threadlab-small">04 — {lang==='es'?'PRESENTACIÓN EN MOVIMIENTO':'MOTION SHOWCASE'}</div><h2>{lang==='es'?'MIRA LA EXPERIENCIA.':'SEE THE EXPERIENCE.'}</h2><video controls playsinline preload="metadata" aria-label={lang==='es'?'Video visual de ThreadLab':'ThreadLab visual walkthrough'}><source src="/projects/threadlab/threadlab-walkthrough.mp4" type="video/mp4"/>{lang==='es'?'Tu navegador no admite el video.':'Your browser does not support this video.'}</video><p>{lang==='es'?'Este video forma parte del material de presentación del proyecto; no certifica por sí solo una implementación funcional del configurador 3D.':'This video is project presentation material; it does not by itself verify a working 3D configurator implementation.'}</p></section>
 <section class="threadlab-outro"><div>ASTRO / CREATIVE DEVELOPMENT</div><h2>{lang==='es'?'DOS PROYECTOS. DIFERENTES LENGUAJES.':'TWO PROJECTS. DIFFERENT VISUAL LANGUAGES.'}</h2><a href={`/${lang}/work/lunaria/`} class="button button-outline">← LUNARIA</a><a href={`/${lang}/work/`} class="button button-dark">{lang==='es'?'Todos los proyectos':'All projects'} ↗</a><p>{lang==='es'?'Pendiente de documentar: componentes Astro, interacciones implementadas, autoría técnica exacta y enlace de demostración.':'To document: Astro components, implemented interactions, exact development responsibilities and demo link.'}</p></section>
 </> : lunaria ? <>
 <section class="lunaria-intro"><div class="lunaria-crumb"><a href={`/${lang}/`}>{t.nav.home}</a><span>/</span><a href={`/${lang}/work/`}>{t.nav.work}</a><span>/</span>Lunaria</div><div class="lunaria-topline"><span>01 / FEATURED ASTRO PROJECT</span><span>WEB DEVELOPMENT × VISUAL DESIGN</span></div><div class="lunaria-header"><div><span class="lunaria-kicker">ASTRO / CASE STUDY</span><h1>LUNARIA<span class="lunaria-star">✳</span></h1></div><p>{lang==='es'?'Un proyecto web donde la dirección visual y la estructura digital conviven: tipografía expresiva, catálogo de tratamientos y composiciones adaptadas a múltiples pantallas.':'A web project where visual direction meets digital structure: expressive typography, treatment catalogue, and layouts adapted across screen sizes.'}</p></div><div class="lunaria-hero"><img src="/projects/lunaria/01-hero.webp" alt={lang==='es'?'Presentación general de Lunaria y su diseño web':'Lunaria full website presentation'} fetchpriority="high"/></div><div class="lunaria-meta"><div><span>{lang==='es'?'TIPO DE PROYECTO':'PROJECT TYPE'}</span><strong>Beauty & wellness website</strong></div><div><span>TECHNOLOGY</span><strong>Astro</strong></div><div><span>{lang==='es'?'MATERIALES':'MATERIALS'}</span><strong>Desktop / Mobile / Video</strong></div></div></section>
 <section class="lunaria-section lunaria-light"><div class="lunaria-section-label">01 / {lang==='es'?'DIRECCIÓN VISUAL':'VISUAL DIRECTION'}</div><div class="lunaria-two"><h2>{lang==='es'?'EL DISEÑO TAMBIÉN COMUNICA.':'DESIGN IS PART OF THE STORY.'}</h2><p>{lang==='es'?'Tipografía contundente, fotografías amplias y un sistema modular de tarjetas construyen una experiencia visual coherente. Las capturas muestran cómo se articulan la portada, el contenido y las secciones comerciales.':'Bold typography, large-scale photography and modular cards create a consistent visual language. The screens show how the landing page, content and service sections fit together.'}</p></div><figure class="lunaria-image"><img src="/projects/lunaria/03-layouts.webp" loading="lazy" alt={lang==='es'?'Composición editorial de las distintas páginas del sitio':'Editorial arrangement of website pages'}/></figure></section>
 <section class="lunaria-section lunaria-dark"><div class="lunaria-section-label">02 / {lang==='es'?'SERVICIOS Y DETALLE':'SERVICES AND DETAIL'}</div><h2>{lang==='es'?'EXPLORAR. COMPARAR. ELEGIR.':'EXPLORE. COMPARE. CHOOSE.'}</h2><div class="lunaria-pair"><img src="/projects/lunaria/02-services.webp" loading="lazy" alt={lang==='es'?'Tarjetas de servicios y ficha detallada de un tratamiento':'Service catalogue and treatment detail panel'}/><div><p>{lang==='es'?'La propuesta contempla un recorrido desde categorías de tratamiento hasta fichas con descripción, precio mostrado en el diseño, duración y llamada a reservar.':'The design presents a path from treatment categories to detailed cards with descriptions, displayed prices, durations and a booking call to action.'}</p><span class="lunaria-side-note">ASTRO / INTERFACE DESIGN</span></div></div></section>
 <section class="lunaria-section lunaria-light"><div class="lunaria-section-label">03 / RESPONSIVE</div><div class="lunaria-two"><h2>{lang==='es'?'UNA IDENTIDAD. VARIAS PANTALLAS.':'ONE IDENTITY. MANY SCREENS.'}</h2><p>{lang==='es'?'El material presenta adaptaciones móviles con una jerarquía visual propia: portada, listado de categorías y formulario de contacto.':'The supplied mobile views show a tailored hierarchy across the landing page, categories and contact form.'}</p></div><img class="lunaria-full" src="/projects/lunaria/04-mobile.webp" loading="lazy" alt={lang==='es'?'Pantallas móviles de Lunaria':'Lunaria mobile interface screens'}/></section>
 <section class="lunaria-section lunaria-gallery"><div class="lunaria-section-label">04 / {lang==='es'?'ESPACIOS Y GALERÍA':'SPACES & GALLERY'}</div><h2>{lang==='es'?'ATMÓSFERA EN CADA DETALLE.':'AN ATMOSPHERE IN EVERY DETAIL.'}</h2><img src="/projects/lunaria/06-spaces.webp" loading="lazy" alt={lang==='es'?'Diseño de la galería de espacios en Lunaria':'Lunaria studio gallery layout'}/><img src="/projects/lunaria/05-gallery.webp" loading="lazy" alt={lang==='es'?'Presentación adicional de la galería':'Additional gallery composition'}/></section>
 <section class="lunaria-section lunaria-video"><div class="lunaria-section-label">05 / {lang==='es'?'RECORRIDO VISUAL':'VISUAL WALKTHROUGH'}</div><h2>{lang==='es'?'EN MOVIMIENTO.':'IN MOTION.'}</h2><video controls preload="metadata" playsinline aria-label={lang==='es'?'Video de presentación de Lunaria':'Lunaria presentation video'}><source src="/projects/lunaria/lunaria-walkthrough.mp4" type="video/mp4"/>{lang==='es'?'Tu navegador no admite este video.':'Your browser does not support this video.'}</video><p>{lang==='es'?'Video de presentación suministrado con el proyecto; no representa una auditoría del sitio publicado.':'Presentation video supplied with the project; not a verification of a live deployment.'}</p></section>
 <section class="lunaria-end"><span>ASTRO / DESIGN-LED DEVELOPMENT</span><h2>{lang==='es'?'SIGUIENTE PROYECTO.':'NEXT PROJECT.'}</h2><a href={`/${lang}/work/`} class="button button-outline">{lang==='es'?'Explorar más trabajos':'Explore more work'} ↗</a><p>{lang==='es'?'Por documentar: rol exacto, componentes desarrollados y enlace público, si existe.':'To document: exact responsibilities, implemented components and public URL, if available.'}</p></section>
 </> : <><div class="page-top section"><div class="eyebrow"><a href={`/${lang}/`}>{t.nav.home}</a> / <a href={`/${lang}/work/`}>{t.nav.work}</a> / {p.name}</div><span class="chapter">{t.case} / {p.type}</span><h1>{p.name}<span class="accent">.</span></h1><p>{p[lang]}</p><div class="tags tags-top">{p.stack.map(s=><i>{s}</i>)}</div>{p.url&&<a href={p.url} rel="noopener noreferrer" target="_blank" class="button button-outline">{t.go} ↗</a>}</div><div class="case-showcase"><div class="technical-window"><div class="window-head"><i></i><i></i><i></i><span>{p.slug}/src/pages/index.astro</span></div><pre><code>{lang==='es'?'Documentación de implementación':'Implementation notes'} — {p.stack.join(' / ')}</code></pre></div><div class="case-caption">{t.writing.toUpperCase()} / {p.name}</div></div><section class="section case-copy"><div class="eyebrow">01 / {t.caseIntro}</div><h2>{t.capTitle}</h2><p>{t.caseBody}</p><a href={`/${lang}/work/`} class="button button-dark">← {t.nav.work}</a></section></>}
</Layout>
