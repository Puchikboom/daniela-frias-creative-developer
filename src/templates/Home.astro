---
import Layout from '../layouts/Layout.astro';
import {showcase} from '../data/showcase.js';
import TechnicalExpertise from '../components/TechnicalExpertise.astro';
const {lang}=Astro.props;
const es=lang==='es';
const tags=es?['Desarrollo front-end','Interfaces con personalidad','Movimiento con intención']:['Front-end development','Interfaces with character','Motion with purpose'];
const copy={es:{role:'FRONT-END DEVELOPER · REACT · TYPESCRIPT',intro:'Siete años desarrollando para la web, doce trabajando en remoto y casi ocho colaborando con una empresa estadounidense. React, TypeScript y PHP con criterio UX/UI.',work:'Proyectos que hablan por sí mismos.',sub:'Once universos visuales. Un mismo interés: cómo se siente una experiencia cuando diseño y desarrollo trabajan juntos.',browse:'Ver el proyecto',workall:'Explorar los once proyectos',lab:'El código también puede jugar.',labdesc:'Seis experimentos originales: tipografía cinética, Canvas, SVG, exploración de datos y una aplicación React + TypeScript con estados de red.',labcta:'Abrir el laboratorio',approach:'Diseño con oficio. Desarrollo con intención.',approachdesc:'Mi trayectoria viene de las artes visuales, el diseño gráfico y UX/UI. Ahora la aplico a arquitecturas web, componentes, interacción, rendimiento y experiencias responsive.',about:'Conoce mi trayectoria',stack:'MI CAJA DE HERRAMIENTAS',stackLead:'No son solo logos en una lista: son formas de resolver problemas.',contact:'¿Construimos algo interesante?',contactcta:'Hablemos',motion:'MOVER LAS LETRAS',scroll:'DESLIZA PARA EXPLORAR'},en:{role:'FRONT-END DEVELOPER · REACT · TYPESCRIPT',intro:'Seven years in web development, twelve years working remotely and nearly eight collaborating with a US-based company. React, TypeScript and PHP backed by UX/UI expertise.',work:'Projects that speak for themselves.',sub:'Eleven visual worlds. One shared obsession: what happens when design and development work together.',browse:'Explore project',workall:'Explore all eleven projects',lab:'Code should get to play, too.',labdesc:'Six original experiments: kinetic typography, Canvas, SVG, data exploration, and a React + TypeScript app built around network request states.',labcta:'Open playground',approach:'A designer’s eye. A developer’s craft.',approachdesc:'My background spans visual arts, graphic design and UX/UI. I now bring it to web architecture, components, interaction, performance and responsive experiences.',about:'About my background',stack:'THE TOOLKIT',stackLead:'Not just a logo wall. Different tools for different challenges.',contact:'Shall we make something good?',contactcta:'Get in touch',motion:'MOVE THE LETTERS',scroll:'SCROLL TO EXPLORE'}}[lang];
const tracks=[{label:es?'BASES / LENGUAJES':'FOUNDATIONS / LANGUAGES',items:['HTML','CSS','JavaScript','TypeScript','PHP','SQL']},{label:es?'SITIOS / APLICACIONES':'SITES / APPLICATIONS',items:['Astro','SvelteKit','React','Next.js','WordPress']},{label:es?'INTERACCIÓN / MOTION':'INTERACTION / MOTION',items:['Testing','CI/CD','Git','REST APIs','SVG','Canvas']}];
---
<Layout lang={lang} page="home" title={`Daniela Frías — ${es?'Desarrollo web creativo':'Creative Web Developer'}`}>
<section class="folio-hero" aria-labelledby="hero-headline">
 <div class="folio-topline"><span>DF® / INDEPENDENT DIGITAL PRACTICE</span><span>{copy.role}</span><span>PORTFOLIO / 2026</span></div>
 <div class="folio-masthead" aria-label="Daniela Frías"><span class="folio-first">DANIELA</span><span class="folio-last">FRÍAS<span class="folio-period">.</span></span><span class="folio-masthead-index" aria-hidden="true">DESIGN<br/>× CODE<br/>× MOTION</span></div>
 <div class="folio-hero-grid"><div class="folio-intro"><span class="folio-caption">01 / {es?'EL PUNTO DE PARTIDA':'THE STARTING POINT'}</span><h1 id="hero-headline">{es?'No solo diseño':'I don’t just design'}<span class="folio-italic">{es?'para la web.':'for the web.'}</span><span class="folio-outline">{es?'La construyo.':'I build it.'}</span></h1><p>{copy.intro}</p><div class="folio-actions"><a href={`/${lang}/work/`} class="folio-btn">{es?'Ver los proyectos':'See the projects'} <span aria-hidden="true">↗</span></a><a href={`/${lang}/about/`} class="folio-textlink">{es?'Más sobre mí':'More about me'} ↗</a></div></div>
 <div class="folio-stage" aria-label={es?'Collage interactivo de proyectos':'Interactive project collage'}><div class="folio-stage-grid" aria-hidden="true"></div><div class="folio-stage-label">{copy.motion} <span>↗</span></div><a class="folio-floating folio-floating-one" href={`/${lang}/work/threadlab/`} aria-label="ThreadLab"><img src={showcase[1].images[0]} alt="ThreadLab — fashion technology" fetchpriority="high"/><small>01 / THREADLAB · ASTRO</small></a><a class="folio-floating folio-floating-two" href={`/${lang}/work/lunaria/`} aria-label="Lunaria"><img src={showcase[0].images[0]} alt="Lunaria — editorial website" fetchpriority="high"/><small>02 / LUNARIA · ASTRO</small></a><div class="folio-stage-disc" aria-hidden="true">↘</div><span class="folio-coordinates">X: <span id="folio-x">000</span> / Y: <span id="folio-y">000</span></span></div></div>
 <div class="folio-hero-foot"><span>↘ {copy.scroll}</span><span>{showcase.length} PROJECTS / ES ↔ EN</span><span>© 2026 DF</span></div>
</section>
<section class="folio-work" id="featured"><div class="folio-section-top"><span>02 / SELECTED DIGITAL WORK</span><span>001 — {String(showcase.length).padStart(3,'0')}</span></div><div class="folio-section-title"><h2>{copy.work}</h2><p>{copy.sub}</p></div><div class="folio-projects">{showcase.map((p,i)=><a class:list={['folio-project',{'folio-project-wide':i===0||i===3}]} href={`/${lang}/work/${p.slug}/`} style={`--work-accent:${p.theme}`} data-reveal><figure><img src={p.images[0]} loading={i===0?'eager':'lazy'} alt={`${p.name}: ${p.group}`}/><span class="folio-project-open" aria-hidden="true">↗</span></figure><div class="folio-project-info"><span>{String(p.projectNumber ?? i+1).padStart(2,'0')} / {p.group}</span><h3>{p.name}</h3><span>{p.confirmed.length?p.confirmed.join(' · '):(es?'Concepto / stack sin verificar':'Concept / stack unverified')}</span></div></a>)}</div><a class="folio-endlink" href={`/${lang}/work/`}>{copy.workall} <span>↗</span></a></section>
<section class="engineering-spotlight" style="padding:65px clamp(18px,4vw,70px);background:#d1e28f;color:#201a21;border-top:2px solid #201a21"><div class="folio-section-top"><span>03 / ENGINEERING PRACTICE</span><span>REACT × TYPESCRIPT × PHP</span></div><div style="display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end;padding:45px 0 0"><h2 style="font:900 clamp(45px,6vw,105px)/.96 'DM Sans',sans-serif;letter-spacing:-.07em;margin:0">{es?'También construyo':'I build beyond'}<br/><em style="font:italic 500 1em 'Playfair Display',serif;color:#963c5c">{es?'lo que no se ve.':'the surface.'}</em></h2><div><p style="font-size:19px;line-height:1.6">{es?'Explora laboratorios originales de ingeniería front-end y PHP: React, TypeScript, APIs y desarrollo WordPress. Código público; demos documentadas y probadas.':'Explore original front-end and PHP engineering labs: React, TypeScript, APIs and custom WordPress development. Public source; documented, tested demos.'}</p><a class="folio-btn" href={`/${lang}/engineering/`}>{es?'Ver proyectos técnicos':'Explore engineering work'} ↗</a></div></div></section><section class="folio-toolkit"><div class="folio-section-top"><span>03 / {copy.stack}</span><span>DESIGN × ENGINEERING</span></div><h2>{copy.stackLead}</h2><div class="folio-tool-columns">{tracks.map((t,i)=><div class="folio-tool-column"><span>0{i+1} / {t.label}</span>{t.items.map((tool,j)=><div class="folio-tool-row"><strong>{tool}</strong><small>{String(j+1).padStart(2,'0')}</small></div>)}</div>)}</div><p class="folio-footnote">{es?'Los stacks confirmados aparecen en cada caso; otras herramientas forman parte del ecosistema de trabajo o de propuestas técnicas.':'Confirmed stacks are identified in each case; other tools represent the broader working ecosystem or technical proposals.'}</p></section>
<TechnicalExpertise lang={lang} placement="home"/>
<section class="folio-play"><span class="folio-caption">04 / JAVASCRIPT PLAYGROUND</span><div class="folio-play-layout"><div><h2>{copy.lab}</h2><p>{copy.labdesc}</p><a class="folio-btn" href={`/${lang}/playground/`}>{copy.labcta} ↗</a></div><div class="folio-play-word" aria-label="MAKE IT MOVE">{Array.from('MOVE').map((letter,i)=><span style={`--i:${i}`} tabindex="0">{letter}</span>)}<small>HOVER / FOCUS / POINTER</small></div></div></section>
<section class="folio-about"><span class="folio-caption">05 / ABOUT THE PRACTICE</span><div><h2>{copy.approach}</h2><p>{copy.approachdesc}</p><a class="folio-textlink" href={`/${lang}/about/`}>{copy.about} ↗</a></div><div class="folio-about-index" aria-hidden="true">D<br/>/F</div></section>
<section class="folio-final-cta"><span>06 / OPEN FOR COLLABORATION</span><h2>{copy.contact}</h2><a href="mailto:briefcase.df@gmail.com">{copy.contactcta} <span aria-hidden="true">↗</span></a></section>
<script is:inline>
(()=>{const stage=document.querySelector('.folio-stage');const a=stage?.querySelector('.folio-floating-one');const b=stage?.querySelector('.folio-floating-two');let raf=0;const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;if(stage&&!reduced&&window.matchMedia('(pointer:fine)').matches){stage.addEventListener('pointermove',event=>{const r=stage.getBoundingClientRect();const x=(event.clientX-r.left)/r.width-.5;const y=(event.clientY-r.top)/r.height-.5;cancelAnimationFrame(raf);raf=requestAnimationFrame(()=>{a.style.translate=`${x*17}px ${y*14}px`;b.style.translate=`${x*-14}px ${y*-12}px`;stage.querySelector('#folio-x').textContent=String(Math.round((x+.5)*100)).padStart(3,'0');stage.querySelector('#folio-y').textContent=String(Math.round((y+.5)*100)).padStart(3,'0')})});stage.addEventListener('pointerleave',()=>{a.style.translate='0 0';b.style.translate='0 0'})}document.querySelectorAll('.folio-play-word>span').forEach((el,i)=>{const on=()=>{if(!reduced)el.style.transform=`translateY(${-17-i*4}px) rotate(${i%2?9:-9}deg)`};const off=()=>{el.style.transform=''};el.addEventListener('pointerenter',on);el.addEventListener('pointerleave',off);el.addEventListener('focus',on);el.addEventListener('blur',off)})})();
</script>
</Layout>
