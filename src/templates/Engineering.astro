---
import Layout from '../layouts/Layout.astro';
const {lang='en'}=Astro.props;
const es=lang==='es';
const labs=[
 {n:'01',slug:'pulse-studio',name:'Pulse Studio',type:'FRONT-END + API ENGINEERING',tools:['React','TypeScript','PHP','REST APIs'],url:'https://github.com/Puchikboom/daniela-frias-creative-developer/tree/main/labs/pulse-studio',description:es?'Dashboard original de gestión con búsqueda, filtros, operaciones CRUD y una API PHP que valida datos.':'Original management dashboard with search, filtering, CRUD workflows and a PHP data-validation API.',details:es?'La demo pública usa exclusivamente datos ficticios guardados en tu navegador. La API real PHP/SQLite permanece en desarrollo local.':'The public demo uses only synthetic data stored in your browser. The real PHP/SQLite API remains local-only.'},
 {n:'02',slug:'forma-studio',name:'Forma Studio',type:'WORDPRESS + PHP ENGINEERING',tools:['WordPress','PHP 8','REST APIs','Security'],url:'https://github.com/Puchikboom/daniela-frias-creative-developer/tree/main/labs/forma-studio',description:es?'Plugin WordPress original con formularios, validación del servidor, contenido personalizado y lectura REST restringida a administradores.':'Original WordPress plugin featuring form submission, server-side validation, custom content and an admin-restricted REST API.',details:es?'Código publicado y sintaxis PHP validada. La integración con una instalación WordPress temporal y las verificaciones de formulario, permisos REST y privacidad pasaron. Falta auditoría de seguridad de producción.':'Source published and PHP syntax validated. Disposable WordPress/MySQL integration tests passed for forms, private records and REST permissions. Production security review remains pending.'}
];
---
<Layout lang={lang} page="work" title={es?'Ingeniería — Daniela Frías':'Engineering — Daniela Frías'}>
<article class="eng">
 <nav class="eng-top" aria-label={es?'Ruta de navegación':'Breadcrumb'}><a href={`/${lang}/work/`}>← {es?'Todos los proyectos':'All projects'}</a><span>DF / ENGINEERING PRACTICE / 2026</span></nav>
 <header class="eng-hero">
  <span class="eng-eyebrow">{es?'INDEPENDENT ENGINEERING LABS / 01—02':'INDEPENDENT ENGINEERING LABS / 01—02'}</span>
  <h1>{es?'Diseño con':'Design with'}<br/><em>{es?'estructura.':'structure.'}</em></h1>
  <p>{es?'Dos proyectos originales para mostrar la intersección entre interfaces de alta calidad y desarrollo backend: código público, decisiones de arquitectura y limitaciones documentadas.':'Two original projects exploring the intersection of high-quality interfaces and back-end engineering: public source, architectural decisions and transparently documented limitations.'}</p>
 </header>
 <div class="eng-strip"><span>REACT / TYPESCRIPT</span><span>PHP / WORDPRESS</span><span>REST APIs</span><span>GITHUB ACTIONS</span></div>
 <section class="eng-cases" aria-label={es?'Proyectos técnicos':'Engineering projects'}>
  {labs.map((p,i)=><section class:list={['eng-card',{'eng-dark':i===1}]}>
   <div class="eng-card-top"><span>{p.n} / {p.type}</span><span>{es?'PROTOTIPO INDEPENDIENTE':'INDEPENDENT PROTOTYPE'}</span></div>
   <div class="eng-card-grid">
     <div><h2>{p.name}<span>.</span></h2><p class="eng-summary">{p.description}</p><div class="eng-tags">{p.tools.map(t=><span>{t}</span>)}</div></div>
     <div class="eng-diagram" aria-label={es?'Diagrama de arquitectura':'Architecture diagram'}>
       {p.slug==='pulse-studio' ? <><div>REACT / TS</div><span>↔</span><div>PHP REST API</div><span>↔</span><div>DEMO DATA</div></> : <><div>FORM + NONCE</div><span>→</span><div>WORDPRESS / PHP</div><span>→</span><div>ADMIN REST</div></>}
     </div>
   </div>
   <div class="eng-card-bottom"><p>{p.details}</p>{p.slug==='forma-studio'&&<a href={`/${lang}/engineering/forma-studio/`} class="eng-demo-link">{es?'LEER CASO TÉCNICO':'READ TECHNICAL CASE'} ↗</a>}{p.slug==='pulse-studio'&&<a href="/pulse-studio/" class="eng-demo-link">{es?'PROBAR DEMO INTERACTIVA':'TRY INTERACTIVE DEMO'} ↗</a>}<a href={p.url} target="_blank" rel="noopener noreferrer">{es?'EXPLORAR EL CÓDIGO':'EXPLORE SOURCE CODE'} ↗</a></div>
  </section>)}
 </section>
 <section class="eng-principles"><span class="eng-eyebrow">03 / {es?'PRINCIPIOS':'ENGINEERING PRINCIPLES'}</span><h2>{es?'Construir bien.':'Built with intent.'}</h2><div><p>{es?'Este trabajo es independiente: todos los nombres y datos son ficticios. No se utiliza material confidencial de empresas o clientes.':'All work here is independent. Every company and record is fictional. No employer or client confidential material is used.'}</p><p>{es?'Las demos están claramente identificadas como prototipos hasta superar pruebas funcionales y de seguridad.':'These demos are explicitly labeled as prototypes until full functionality and security checks are complete.'}</p></div></section>
</article>
<style>
.eng{background:#eeeae2;color:#221c27;min-height:100vh;padding:24px clamp(20px,5vw,80px) 110px}.eng-top{display:flex;justify-content:space-between;border-bottom:1px solid #251e2a;padding-bottom:22px;gap:20px;font:600 11px 'DM Mono',monospace}.eng-top a{text-decoration:underline;text-underline-offset:5px}.eng-hero{padding:90px 0 75px;max-width:1100px}.eng-eyebrow{font:700 12px 'DM Mono',monospace;letter-spacing:.08em;color:#a54370}.eng-hero h1{font:900 clamp(68px,10vw,165px)/.88 'DM Sans',sans-serif;letter-spacing:-.085em;margin:22px 0 30px}.eng-hero h1 em{font:italic 500 1em 'Playfair Display',serif;color:#9d3d65}.eng-hero p{max-width:750px;font-size:clamp(17px,2vw,23px);line-height:1.55}.eng-strip{display:flex;flex-wrap:wrap;justify-content:space-between;gap:15px;padding:18px 0;border-top:2px solid #201923;border-bottom:2px solid #201923;font:700 11px 'DM Mono',monospace}.eng-cases{display:grid;gap:20px;padding-top:45px}.eng-card{background:#c7df8d;padding:clamp(22px,4vw,50px);min-height:480px}.eng-card.eng-dark{background:#271e2d;color:#f3eae2}.eng-card-top{display:flex;justify-content:space-between;gap:25px;border-bottom:1px solid currentColor;padding-bottom:16px;font:700 10px 'DM Mono',monospace}.eng-card-grid{display:grid;grid-template-columns:1fr .75fr;align-items:center;gap:40px;padding:40px 0}.eng-card h2{font:900 clamp(55px,7vw,110px)/.95 'DM Sans',sans-serif;letter-spacing:-.085em;margin:0}.eng-card h2 span{color:#a54370}.eng-summary{font-size:clamp(16px,1.8vw,20px);line-height:1.55;max-width:580px}.eng-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:25px}.eng-tags span{font:700 11px 'DM Mono',monospace;border:1px solid currentColor;padding:8px 11px}.eng-diagram{border:1px solid currentColor;padding:30px 20px;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;min-height:200px}.eng-diagram div{border:2px solid currentColor;padding:14px 12px;font:700 11px 'DM Mono',monospace;text-align:center}.eng-diagram>span{font-size:28px}.eng-card-bottom{display:flex;justify-content:space-between;align-items:end;gap:25px;border-top:1px solid currentColor;padding-top:18px}.eng-card-bottom p{font-size:13px;line-height:1.5;max-width:600px}.eng-card-bottom a{font:800 11px 'DM Mono',monospace;border-bottom:2px solid;padding-bottom:7px;white-space:nowrap}.eng-principles{padding-top:85px;display:grid;grid-template-columns:1fr 1fr;gap:18px}.eng-principles>.eng-eyebrow{grid-column:1/-1}.eng-principles h2{font:900 clamp(48px,6vw,94px)/1 'DM Sans',sans-serif;letter-spacing:-.07em;margin:0}.eng-principles>div{font-size:16px;line-height:1.7;max-width:550px}@media(max-width:800px){.eng-card-grid,.eng-principles{grid-template-columns:1fr}.eng-hero{padding:65px 0}.eng-card-bottom{flex-direction:column;align-items:start}.eng-top>span{display:none}.eng-card h2{font-size:56px}.eng-diagram{min-height:150px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</Layout>