---
import Layout from '../layouts/Layout.astro';
const {lang='en'}=Astro.props;
const es=lang==='es';
const copy=es?{
 back:'Volver al proyecto',kicker:'THREADLAB / LABORATORIO INTERACTIVO',head:'El tejido',accent:'toma forma.',intro:'Un configurador experimental de prendas. Cambia el tejido, el color y la silueta: cada decisión transforma la vista previa en tiempo real.',editor:'ESTUDIO DE CONFIGURACIÓN',options:'01 / MATERIAL Y FORMA',fabric:'TEJIDO',color:'COLOR',fit:'SILUETA',mark:'MONOGRAMA',markHelp:'Máximo tres caracteres; solo letras y números.',grid:'Mostrar retícula técnica',reset:'Restablecer',share:'Copiar enlace',copied:'Enlace copiado',save:'Guardar diseño',saved:'Diseño guardado',preview:'VISTA PREVIA / SVG EN DIRECTO',front:'FRENTE',backView:'ESPALDA',material:'MATERIAL',price:'PRECIO ORIENTATIVO',note:'Concepto independiente. Precios ficticios. Sin fabricación, compras ni procesamiento de pedidos.',details:'02 / DETRÁS DE LA INTERFAZ',detailsHead:'Interacción real. Sin ilusiones.',detailsBody:'La vista previa se genera con SVG original. Los controles actualizan el estado y se guardan en el navegador. El enlace compartible codifica una configuración reproducible. Incluye soporte para teclado y movimiento reducido.',source:'EXAMINAR CÓDIGO',project:'VER CASO ORIGINAL',export:'Descargar SVG',description:'Visualización bidimensional; no es un motor de renderizado 3D.'
}:{
 back:'Back to project',kicker:'THREADLAB / INTERACTIVE LAB',head:'Make the',accent:'fabric yours.',intro:'An experimental garment configurator. Switch fabric, colour and silhouette; each decision transforms the live preview.',editor:'CONFIGURATION STUDIO',options:'01 / MATERIAL & FORM',fabric:'FABRIC',color:'COLOUR',fit:'SILHOUETTE',mark:'MONOGRAM',markHelp:'Up to three letters or numbers.',grid:'Show technical grid',reset:'Reset',share:'Copy link',copied:'Link copied',save:'Save design',saved:'Design saved',preview:'LIVE SVG PREVIEW',front:'FRONT',backView:'BACK',material:'MATERIAL',price:'ILLUSTRATIVE PRICE',note:'Independent concept. All prices are fictional. No manufacturing, checkout or order processing.',details:'02 / UNDER THE HOOD',detailsHead:'Real interaction. No illusions.',detailsBody:'This preview is rendered using original SVG. Controls update application state and persist in your browser. Shareable links encode reproducible configurations. Keyboard controls and reduced motion are supported.',source:'EXPLORE SOURCE',project:'ORIGINAL CASE STUDY',export:'Download SVG',description:'Two-dimensional visualisation; not a 3D rendering engine.'
};
---
<Layout lang={lang} page="work" title={`ThreadLab Interactive — Daniela Frías`}>
<article class="tl" data-lang={lang}>
 <div class="tl-top"><a href={`/${lang}/work/threadlab/`}>← {copy.back}</a><span>DF / R&D 002 — 2026</span></div>
 <header class="tl-hero"><span class="tl-kicker">{copy.kicker}</span><h1>{copy.head}<br/><em>{copy.accent}</em></h1><p>{copy.intro}</p><div class="tl-marquee" aria-hidden="true"><span>DESIGN × CODE × MATERIAL × MOTION × DESIGN × CODE × MATERIAL × MOTION</span></div></header>
 <div class="tl-studio">
   <section class="tl-controls" aria-labelledby="tl-control-heading">
     <div class="tl-counter">TL / 002 <span>01—04</span></div>
     <h2 id="tl-control-heading">{copy.editor}<span>.</span></h2>
     <div class="tl-subtitle">{copy.options}</div>
     <fieldset><legend>01 / {copy.fabric}</legend>
      <div class="tl-fabric-choices">
       <label><input type="radio" name="fabric" value="cotton" checked/><span>{es?'Sarga de algodón':'Cotton twill'}<small>240 GSM</small></span></label>
       <label><input type="radio" name="fabric" value="canvas"/><span>{es?'Lona estructurada':'Structured canvas'}<small>320 GSM</small></span></label>
       <label><input type="radio" name="fabric" value="linen"/><span>{es?'Lino texturizado':'Textured linen'}<small>190 GSM</small></span></label>
      </div>
     </fieldset>
     <fieldset><legend>02 / {copy.color}</legend><div class="tl-colors">
       <label><input type="radio" name="color" value="ink" checked/><span class="tl-swatch" style="--swatch:#29212D" title={es?'Tinta profunda':'Deep ink'}></span><small>{es?'Tinta':'Ink'}</small></label>
       <label><input type="radio" name="color" value="berry"/><span class="tl-swatch" style="--swatch:#A65F7C" title={es?'Baya':'Berry'}></span><small>{es?'Baya':'Berry'}</small></label>
       <label><input type="radio" name="color" value="sage"/><span class="tl-swatch" style="--swatch:#9CB7A2" title={es?'Salvia':'Sage'}></span><small>{es?'Salvia':'Sage'}</small></label>
       <label><input type="radio" name="color" value="cream"/><span class="tl-swatch" style="--swatch:#E4D9C8" title={es?'Crema':'Cream'}></span><small>{es?'Crema':'Cream'}</small></label>
       <label><input type="radio" name="color" value="cobalt"/><span class="tl-swatch" style="--swatch:#5879D1" title={es?'Azul':'Cobalt'}></span><small>{es?'Azul':'Blue'}</small></label>
     </div></fieldset>
     <fieldset><legend>03 / {copy.fit}</legend><div class="tl-fit">
       <label><input type="radio" name="fit" value="regular" checked/><span>{es?'Regular':'Regular'}</span></label>
       <label><input type="radio" name="fit" value="relaxed"/><span>{es?'Holgado':'Relaxed'}</span></label>
       <label><input type="radio" name="fit" value="oversized"/><span>{es?'Amplio':'Oversized'}</span></label>
     </div></fieldset>
     <fieldset><legend>04 / {copy.mark}</legend>
       <label class="tl-field"><span class="tl-helper">{copy.markHelp}</span><input id="tl-monogram" type="text" value="DF" maxlength="3" autocomplete="off" spellcheck="false" aria-label={copy.mark}/></label>
     </fieldset>
     <label class="tl-toggle"><input id="tl-grid" type="checkbox" checked/>{copy.grid}</label>
     <div class="tl-buttons"><button type="button" id="tl-reset">{copy.reset}</button><button type="button" id="tl-share">{copy.share}</button></div>
     <p class="tl-feedback" role="status" aria-live="polite" id="tl-feedback"></p>
   </section>
   <section class="tl-preview" aria-labelledby="tl-preview-heading">
     <div class="tl-preview-head"><span id="tl-preview-heading">{copy.preview}</span><span>TL / CUSTOM 01</span></div>
     <div class="tl-canvas" id="tl-canvas">
      <svg id="tl-garment" role="img" aria-label={es?'Prenda personalizable vista frontal':'Customizable garment front view'} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 640">
       <defs><pattern id="tl-grain" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M0 12L12 0" stroke="#fff" stroke-opacity=".11" stroke-width="1"/></pattern><pattern id="tl-cross" width="15" height="15" patternUnits="userSpaceOnUse"><path d="M0 0H15M0 0V15" stroke="#fff" stroke-opacity=".22" fill="none" stroke-width="1"/></pattern><pattern id="tl-lines" width="8" height="8" patternUnits="userSpaceOnUse"><path d="M0 0L8 8" stroke="#fff" stroke-opacity=".18" stroke-width="1"/></pattern><pattern id="tl-pattern" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M0 12L12 0" stroke="#fff" stroke-opacity=".11" stroke-width="1"/></pattern></defs>
       <g class="tl-tech-grid" id="tl-tech-grid" aria-hidden="true"><path d="M100 0V640 M200 0V640 M300 0V640 M400 0V640 M500 0V640 M0 100H600 M0 200H600 M0 300H600 M0 400H600 M0 500H600 M0 600H600" stroke="#ffffff" stroke-opacity=".08"/><path d="M300 20V620 M40 320H560" stroke="#e8e3dc" stroke-opacity=".22" stroke-dasharray="4 7"/></g>
       <g id="tl-shirt" fill="#29212d" stroke="#e4d7d3" stroke-width="2" stroke-linejoin="round">
        <path id="tl-body" d="M215 115L252 97Q300 132 348 97L385 115L455 161L504 268L425 298L400 254L400 542L200 542L200 254L175 298L96 268L145 161Z"/>
        <path id="tl-texture" d="M215 115L252 97Q300 132 348 97L385 115L455 161L504 268L425 298L400 254L400 542L200 542L200 254L175 298L96 268L145 161Z" fill="url(#tl-grain)" stroke="none"/>
        <path d="M252 97Q300 190 348 97Q300 132 252 97Z" fill="#131018" stroke-width="3"/>
        <path id="tl-seams" d="M201 250L201 542M399 250L399 542M215 115L201 250M385 115L399 250M201 527H399M96 268L175 294M425 294L504 268" fill="none" stroke="#fff" stroke-opacity=".36" stroke-width="2" stroke-dasharray="5 4"/>
        <text id="tl-shirt-mark" x="340" y="265" fill="#f6eada" stroke="none" font-family="Arial, sans-serif" font-weight="700" font-size="26" text-anchor="middle">DF</text>
       </g>
       <text x="45" y="45" fill="#fff" opacity=".55" font-family="monospace" font-size="13">FRONT / 001</text>
       <text x="45" y="603" fill="#fff" opacity=".55" font-family="monospace" font-size="12">TECHNICAL STUDY / NOT TO SCALE</text>
      </svg>
      <div class="tl-canvas-label"><span>{copy.front}</span><span>100% SVG</span></div>
     </div>
     <div class="tl-specs"><div><small>{copy.material}</small><strong id="tl-material">Cotton twill · 240 GSM</strong></div><div><small>{copy.price}</small><strong id="tl-price">$79</strong></div></div>
     <div class="tl-export"><button id="tl-export" type="button">{copy.export} ↗</button><span>{copy.description}</span></div>
   </section>
 </div>
 <footer class="tl-outro"><div><span class="tl-kicker">{copy.details}</span><h2>{copy.detailsHead}</h2><p>{copy.detailsBody}</p><p class="tl-note">{copy.note}</p></div><div class="tl-outro-links"><a href="https://github.com/Puchikboom/daniela-frias-creative-developer/tree/main/public/threadlab" target="_blank" rel="noopener noreferrer">{copy.source} ↗</a><a href={`/${lang}/work/threadlab/`}>{copy.project} ↗</a></div></footer>
</article>
<script define:vars={{lang,feedbackCopied:copy.copied,feedbackSaved:copy.saved}}>
 import '/threadlab/configurator.js';
</script>
<style>
.tl{background:#ece8e1;color:#211c25}.tl-top{display:flex;justify-content:space-between;gap:20px;padding:24px clamp(20px,4.8vw,74px);border-bottom:1px solid #2b2030;font:600 11px 'DM Mono',monospace}.tl-top a{text-decoration:underline;text-underline-offset:4px}.tl-hero{padding:80px clamp(20px,4.8vw,74px) 65px;overflow:hidden}.tl-kicker{font:700 11px 'DM Mono',monospace;letter-spacing:.16em;color:#a34273}.tl-hero h1{font:900 clamp(70px,10vw,160px)/.88 'DM Sans',Arial,sans-serif;letter-spacing:-.09em;margin:27px 0}.tl-hero h1 em{font:italic 500 1em 'Playfair Display',Georgia,serif;color:#a34273}.tl-hero p{font-size:clamp(17px,2vw,23px);max-width:700px;line-height:1.5}.tl-marquee{border-top:1px solid #231b29;border-bottom:1px solid #231b29;margin-top:65px;padding:15px 0;overflow:hidden;white-space:nowrap;font:700 13px 'DM Mono',monospace;letter-spacing:.15em}.tl-marquee span{display:block;min-width:max-content}.tl-studio{display:grid;grid-template-columns:minmax(320px,.85fr) minmax(0,1.2fr);gap:0;padding:0 clamp(20px,4.8vw,74px) 85px}.tl-controls{background:#faf6ef;padding:clamp(22px,4vw,48px);border:1px solid #d4c8ce}.tl-counter,.tl-preview-head{display:flex;justify-content:space-between;gap:20px;font:700 11px 'DM Mono',monospace;letter-spacing:.1em}.tl-controls h2{font:900 clamp(32px,3.7vw,56px)/1 'DM Sans',sans-serif;letter-spacing:-.065em;margin:37px 0 25px}.tl-controls h2 span{color:#a34273}.tl-subtitle{font:700 11px 'DM Mono',monospace;padding:10px 0;border-bottom:1px solid #2e2530;letter-spacing:.12em}.tl fieldset{border:0;padding:28px 0 20px;margin:0;border-bottom:1px solid #cec2c6}.tl legend{font:700 11px 'DM Mono',monospace;letter-spacing:.1em;padding:0}.tl-fabric-choices{display:grid;gap:6px}.tl-fabric-choices label{cursor:pointer}.tl-fabric-choices input,.tl-fit input,.tl-colors input{position:absolute;opacity:0;width:1px;height:1px}.tl-fabric-choices span{display:flex;justify-content:space-between;gap:6px;border:1px solid #cabdc3;padding:13px;font-size:13px;font-weight:700}.tl-fabric-choices small{font:600 10px 'DM Mono',monospace}.tl-fabric-choices input:checked+span,.tl-fit input:checked+span{background:#2a202d;color:#fff}.tl-fabric-choices input:focus-visible+span,.tl-fit input:focus-visible+span,.tl-colors input:focus-visible+.tl-swatch{outline:3px solid #a34273;outline-offset:3px}.tl-colors{display:flex;gap:14px;flex-wrap:wrap}.tl-colors label{display:grid;justify-items:center;gap:7px;cursor:pointer}.tl-swatch{background:var(--swatch);display:block;width:38px;height:38px;border-radius:50%;border:2px solid #aaa}.tl-colors input:checked+.tl-swatch{outline:3px solid #271d2e;outline-offset:3px}.tl-colors small{font-size:10px}.tl-fit{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.tl-fit span{display:block;text-align:center;border:1px solid #cabdc3;padding:12px 5px;font-weight:700;font-size:12px}.tl-field{display:grid;gap:9px}.tl-helper{color:#6a5c66;font-size:12px}.tl-field input{padding:12px;border:1px solid #cabdc3;background:#fff;font:700 18px 'DM Mono',monospace;text-transform:uppercase;max-width:200px}.tl-toggle{display:flex;gap:12px;align-items:center;margin:26px 0;cursor:pointer;font-size:13px}.tl-toggle input{accent-color:#a34273;width:18px;height:18px}.tl-buttons{display:flex;gap:9px}.tl-buttons button,.tl-export button{padding:13px 17px;cursor:pointer;font:700 11px 'DM Mono',monospace;letter-spacing:.05em;border:1px solid #2a202d;background:transparent}.tl-buttons button:last-child,.tl-export button{background:#2a202d;color:#fff}.tl-buttons button:hover,.tl-export button:hover{background:#a34273;color:#fff}.tl-feedback{font:600 11px 'DM Mono',monospace;min-height:24px}.tl-preview{background:#2a212f;color:#f7eee8;padding:clamp(19px,3vw,39px);min-width:0;display:flex;flex-direction:column}.tl-preview-head{padding-bottom:15px;border-bottom:1px solid #ffffff6b}.tl-canvas{position:relative;flex:1;min-height:530px;background:radial-gradient(circle at 50% 40%,#4a3a50,#201a27 75%);margin-top:24px}.tl-canvas svg{display:block;width:100%;height:100%;max-height:740px;min-height:440px;transition:transform .2s}.tl-canvas-label{position:absolute;bottom:15px;right:17px;display:flex;gap:12px;font:700 10px 'DM Mono',monospace}.tl-specs{display:grid;grid-template-columns:1fr 1fr;gap:15px;padding:29px 0;border-bottom:1px solid #ffffff64}.tl-specs>div{display:grid;gap:10px}.tl-specs small{font:600 10px 'DM Mono',monospace;letter-spacing:.1em;opacity:.7}.tl-specs strong{font-size:18px}.tl-export{display:flex;align-items:center;justify-content:space-between;gap:15px;padding-top:20px}.tl-export span{font-size:11px;line-height:1.5;max-width:230px;opacity:.7}.tl-outro{display:grid;grid-template-columns:1.5fr .5fr;gap:30px;padding:90px clamp(20px,4.8vw,74px);background:#d4e397}.tl-outro h2{font:900 clamp(50px,6vw,96px)/1 'DM Sans',sans-serif;letter-spacing:-.07em;margin:20px 0}.tl-outro p{font-size:17px;line-height:1.65;max-width:680px}.tl-note{font-size:12px!important}.tl-outro-links{display:flex;flex-direction:column;gap:20px;align-self:center}.tl-outro-links a{font:800 12px 'DM Mono',monospace;border-bottom:2px solid;padding:12px 0}@media(max-width:940px){.tl-studio,.tl-outro{grid-template-columns:1fr}.tl-canvas{min-height:460px}.tl-hero{padding-top:60px}}@media(max-width:500px){.tl-studio{padding-left:13px;padding-right:13px}.tl-colors{gap:9px}.tl-canvas{min-height:350px}.tl-canvas svg{min-height:320px}.tl-specs{grid-template-columns:1fr}.tl-hero h1{font-size:clamp(55px,14vw,100px)}}@media(prefers-reduced-motion:reduce){.tl *{animation:none!important;transition:none!important}}
</style>
</Layout>
