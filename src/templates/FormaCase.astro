---
import Layout from '../layouts/Layout.astro';
const {lang='en'}=Astro.props;
const es=lang==='es';
const data=es?{
back:'Volver a Engineering Practice',kicker:'CASO TÉCNICO / 02',heading:'Backend con',italic:'criterio.',subtitle:'Un plugin WordPress original que convierte un formulario público en registros privados con acceso administrativo controlado.',problem:'EL PROBLEMA',problemText:'No basta con que un formulario tenga buen aspecto. Una experiencia de contacto también necesita validación, almacenamiento, permisos claros y una respuesta comprensible para la persona que lo utiliza.',solution:'LA SOLUCIÓN',solutionText:'Forma Studio implementa un tipo de contenido privado, un shortcode con formulario accesible, validación PHP y una API REST cuya lectura requiere permisos administrativos.',architecture:'01 / ARQUITECTURA',flow:['FORMULARIO','ADMIN-POST + NONCE','PHP / VALIDACIÓN','WORDPRESS + MYSQL','REST / ADMIN'],engineering:'02 / DECISIONES DE INGENIERÍA',points:[['Modelo privado','Consultas guardadas como contenido no público, sin endpoint de lectura anónimo.'],['Entradas controladas','Sanitización y validación en servidor para nombre, correo y mensaje.'],['Permisos explícitos','La ruta REST exige manage_options; la privacidad se comprueba mediante integración.'],['Seguridad por capas','Nonce, campo trampa y limitación básica de envíos. No sustituyen medidas avanzadas en producción.']],quality:'03 / PRUEBAS VERIFICADAS',qualityText:'GitHub Actions instala WordPress y MySQL en un entorno temporal, activa el plugin y verifica el shortcode, el rechazo de tokens inválidos, un envío sintético, el almacenamiento privado y los permisos de la API REST.',limits:'04 / LIMITACIONES HONESTAS',limitsText:'Es un laboratorio independiente. No se ha desplegado un formulario público conectado a una base de datos real ni completado una auditoría de seguridad de producción. Falta una política de retención, protección avanzada contra abuso y una revisión de accesibilidad completa.',source:'EXPLORAR CÓDIGO FUENTE',tests:'VER PRUEBAS DE INTEGRACIÓN',label:'INDEPENDENT WORDPRESS ENGINEERING STUDY / 2026'
}:{
back:'Back to Engineering Practice',kicker:'ENGINEERING CASE / 02',heading:'Backend with',italic:'intent.',subtitle:'An original WordPress plugin turning public form submissions into private records with tightly scoped administrative access.',problem:'THE PROBLEM',problemText:'A contact form needs more than visual polish. It also needs server-side validation, safe data handling, clear permissions, and understandable feedback.',solution:'THE SOLUTION',solutionText:'Forma Studio uses a private custom post type, an accessible form shortcode, PHP validation, and a REST endpoint that requires administrative permissions.',architecture:'01 / ARCHITECTURE',flow:['FORM','ADMIN-POST + NONCE','PHP / VALIDATION','WORDPRESS + MYSQL','REST / ADMIN'],engineering:'02 / ENGINEERING DECISIONS',points:[['Private by design','Inquiries are stored as non-public content without an anonymous read endpoint.'],['Validated input','Server-side sanitization and validation for name, email and message fields.'],['Explicit permissions','The REST route requires manage_options, enforced in integration tests.'],['Layered safeguards','Nonce, honeypot and basic rate limiting. None replace production-grade abuse prevention.']],quality:'03 / VERIFIED TESTS',qualityText:'GitHub Actions provisions disposable WordPress and MySQL, activates the plugin, and checks shortcode rendering, invalid nonce rejection, a synthetic submission, private storage, and REST permission boundaries.',limits:'04 / LIMITATIONS',limitsText:'This is an independent engineering lab. No live public form with a production database has been launched, and no production security audit has been completed. Retention, robust abuse controls and broader accessibility review remain open.',source:'EXPLORE SOURCE CODE',tests:'READ INTEGRATION TESTS',label:'INDEPENDENT WORDPRESS ENGINEERING STUDY / 2026'
};
---
<Layout lang={lang} page="work" title="Forma Studio — Daniela Frías">
<article class="forma-case">
 <nav class="forma-nav"><a href={`/${lang}/engineering/`}>← {data.back}</a><span>DF / ENGINEERING 02</span></nav>
 <header class="forma-hero"><p class="forma-eyebrow">{data.kicker}</p><h1>{data.heading}<br/><em>{data.italic}</em></h1><p class="forma-intro">{data.subtitle}</p><span class="forma-meta">{data.label}</span></header>
 <section class="forma-duo">
  <div><span>01 / {data.problem}</span><p>{data.problemText}</p></div>
  <div><span>02 / {data.solution}</span><p>{data.solutionText}</p></div>
 </section>
 <section class="forma-architecture"><span>{data.architecture}</span><h2>From interface<br/>to <em>persistence.</em></h2><div class="forma-flow">{data.flow.map((step,index)=><div><small>{String(index+1).padStart(2,'0')}</small><strong>{step}</strong></div>)}</div></section>
 <section class="forma-decisions"><span>{data.engineering}</span><div class="forma-grid">{data.points.map((p,i)=><div><small>0{i+1}</small><h3>{p[0]}</h3><p>{p[1]}</p></div>)}</div></section>
 <section class="forma-proof"><div><span>{data.quality}</span><h2>Tested.<br/><em>Not assumed.</em></h2><p>{data.qualityText}</p></div><div class="forma-terminal" aria-label="Test workflow architecture"><span>GITHUB ACTIONS / CI</span><code>WordPress + MySQL</code><code>POST /wp-admin/admin-post.php</code><code>Private custom post type</code><code>GET /wp-json/forma/v1/inquiries</code><strong>CI: INTEGRATION TESTS PASSED ✓</strong></div></section>
 <section class="forma-limits"><span>{data.limits}</span><p>{data.limitsText}</p></section>
 <footer class="forma-links"><a href="https://github.com/Puchikboom/daniela-frias-creative-developer/tree/main/labs/forma-studio" target="_blank" rel="noopener noreferrer">{data.source} ↗</a><a href="https://github.com/Puchikboom/daniela-frias-creative-developer/blob/main/labs/forma-studio/tests/wordpress-integration.sh" target="_blank" rel="noopener noreferrer">{data.tests} ↗</a></footer>
</article>
<style>
.forma-case{color:#261e29;background:#f1ebe2;min-height:100vh;padding:24px clamp(20px,5vw,74px) 95px}.forma-nav{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #322638;padding-bottom:23px;font:700 11px 'DM Mono',monospace}.forma-nav a{text-decoration:underline;text-underline-offset:5px}.forma-hero{padding:90px 0 80px}.forma-eyebrow,.forma-duo span,.forma-architecture>span,.forma-decisions>span,.forma-proof span,.forma-limits span{font:700 11px 'DM Mono',monospace;letter-spacing:.12em}.forma-eyebrow{color:#a13d71}.forma-hero h1{font:900 clamp(75px,10vw,158px)/.9 'DM Sans',Arial,sans-serif;letter-spacing:-.085em;margin:25px 0}.forma-hero h1 em,.forma-architecture h2 em,.forma-proof h2 em{font:italic 500 1em 'Playfair Display',Georgia,serif;color:#a13d71}.forma-intro{max-width:900px;font-size:clamp(20px,2.5vw,28px);line-height:1.5}.forma-meta{font:700 11px 'DM Mono',monospace}.forma-duo{display:grid;grid-template-columns:1fr 1fr}.forma-duo>div{padding:45px;border:1px solid #c2b5be;min-height:250px}.forma-duo>div:first-child{background:#ddc4d0}.forma-duo>div:last-child{background:#d4e59e}.forma-duo p{font-size:18px;line-height:1.65;max-width:600px}.forma-architecture{padding:95px 0}.forma-architecture h2,.forma-proof h2{font:900 clamp(55px,7vw,98px)/.95 'DM Sans',Arial,sans-serif;letter-spacing:-.075em;margin:30px 0 55px}.forma-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.forma-flow>div{display:flex;flex-direction:column;justify-content:space-between;min-height:146px;border:2px solid #34233a;padding:16px}.forma-flow>div:nth-child(even){background:#34233a;color:#fff}.forma-flow small{font:700 12px 'DM Mono',monospace}.forma-flow strong{font:800 13px 'DM Mono',monospace;overflow-wrap:anywhere}.forma-decisions{padding:60px 0 95px;border-top:2px solid #34233a}.forma-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:36px;margin-top:40px}.forma-grid>div{border-bottom:1px solid #a29aa0;padding:0 0 35px}.forma-grid small{color:#a13d71}.forma-grid h3{font:800 clamp(25px,3vw,38px) 'DM Sans',sans-serif;margin:13px 0}.forma-grid p{font-size:16px;line-height:1.6;max-width:550px}.forma-proof{background:#2a212f;color:#f7f0e7;padding:55px;display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}.forma-proof p{font-size:17px;line-height:1.6}.forma-terminal{border:1px solid #ad9dad;padding:30px;display:grid;gap:18px}.forma-terminal span{color:#d4e59e}.forma-terminal code{font:13px 'DM Mono',monospace;color:#efe3eb}.forma-terminal strong{font:700 12px 'DM Mono',monospace;color:#d4e59e}.forma-limits{padding:60px 0;display:grid;grid-template-columns:1fr 2fr;gap:40px}.forma-limits p{font-size:16px;line-height:1.6;max-width:800px;margin:0}.forma-links{display:flex;justify-content:space-between;gap:25px;border-top:2px solid #312338;padding-top:25px}.forma-links a{font:800 12px 'DM Mono',monospace;border-bottom:2px solid;padding:10px 0}@media(max-width:800px){.forma-duo,.forma-grid,.forma-proof,.forma-limits{grid-template-columns:1fr}.forma-flow{grid-template-columns:repeat(2,1fr)}.forma-proof{padding:25px}.forma-hero{padding:65px 0}.forma-nav>span{display:none}}@media(max-width:480px){.forma-flow{grid-template-columns:1fr}.forma-duo>div{padding:22px}.forma-links{flex-direction:column}.forma-hero h1{font-size:62px}}
</style>
</Layout>
